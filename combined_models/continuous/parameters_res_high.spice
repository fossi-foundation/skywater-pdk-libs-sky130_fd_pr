.param sw_rcl1_mcz = 'agauss(0,1,1)'
.param sw_rcl1_mcd = 'sw_rcl1_mcz'
.param sw_rcl1 = {(9.3+corner_factor*9.31)*exp(process_mc_factor*MC_PR_SWITCH*0.39*sw_rcl1_mcd)}
.param sw_rl1_mcz = 'agauss(0,1,1)'
.param sw_rl1_mcd = 'sw_rl1_mcz'
.param sw_rl1 = {(12.3+corner_factor*2.5)*(1+process_mc_factor*MC_PR_SWITCH*0.05*sw_rl1_mcd)}
.param sw_rl1_dw = {0.0+corner_factor*-2e-08}
.param sw_rnw_mcz = 'agauss(0,1,1)'
.param sw_rnw_mcd = 'sw_rnw_mcz'
.param sw_rnw = {(1700.0+corner_factor*460.0)*(1+process_mc_factor*MC_PR_SWITCH*0.0375*sw_rnw_mcd)}
.param sw_rp1_mcz = 'agauss(0,1,1)'
.param sw_rp1_mcd = 'sw_rp1_mcz'
.param sw_rp1 = {(48.2+corner_factor*7.4)*(1+process_mc_factor*MC_PR_SWITCH*0.025*sw_rp1_mcd)}
.param sw_rcn_mcz = 'agauss(0,1,1)'
