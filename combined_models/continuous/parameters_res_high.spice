.param sw_m5_dw = {0.0+corner_factor*-1.7e-07}
.param sw_rcvia_mcz = 'agauss(0,1,1)'
.param sw_rcvia_mcd = 'sw_rcvia_mcz'
.param sw_rcvia = {(4.5+corner_factor*7.35)*exp(process_mc_factor*MC_PR_SWITCH*0.26*sw_rcvia_mcd)}
.param sw_rcvia2_mcz = 'agauss(0,1,1)'
