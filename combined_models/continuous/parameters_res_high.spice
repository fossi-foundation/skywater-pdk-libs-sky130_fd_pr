.param sw_rdp_mcz = 'agauss(0,1,1)'
.param sw_rdp_mcd = 'sw_rdp_mcz'
.param sw_rdp = {(197.0+corner_factor*31.0)*(1+process_mc_factor*MC_PR_SWITCH*0.0375*sw_rdp_mcd)}
.param sw_pw_rs = {3816.0+corner_factor*1034.0}
