*
* ./parameters_res_high.spice created from ./parameters.spice
*
* Process Monte Carlo:  For each process parameter X, X_mcz is a random
* draw (standard normal), which ngspice evaluates again at every place it
* is used.  X_mcd = X_mcz is evaluated only once, so that all devices
* share the same process value (one draw per die per simulation run).
.param sw_sky130_fd_pr__res_high_po_rs_mcz = 'agauss(0,1,1)'
.param sw_sky130_fd_pr__res_high_po_rs_mcd = 'sw_sky130_fd_pr__res_high_po_rs_mcz'
.param sw_sky130_fd_pr__res_high_po_rs = {(325.0+corner_factor*45.0)*(1+process_mc_factor*MC_PR_SWITCH*0.035*sw_sky130_fd_pr__res_high_po_rs_mcd)}
.param sw_sky130_fd_pr__res_xhigh_po_rs_mcz = 'agauss(0,1,1)'
.param sw_sky130_fd_pr__res_xhigh_po_rs_mcd = 'sw_sky130_fd_pr__res_xhigh_po_rs_mcz'
.param sw_sky130_fd_pr__res_xhigh_po_rs = {(2000.0+corner_factor*300.0)*(1+process_mc_factor*MC_PR_SWITCH*0.04*sw_sky130_fd_pr__res_xhigh_po_rs_mcd)}
.param sw_poly_head_res_mcz = 'agauss(0,1,1)'
.param sw_poly_head_res_mcd = 'sw_poly_head_res_mcz'
.param sw_poly_head_res = {(1.0+corner_factor*0.125)*(1+process_mc_factor*MC_PR_SWITCH*0.025*sw_poly_head_res_mcd)}
.param sw_sky130_fd_pr__res_generic_m1_rs_mcz = 'agauss(0,1,1)'
.param sw_sky130_fd_pr__res_generic_m1_rs_mcd = 'sw_sky130_fd_pr__res_generic_m1_rs_mcz'
.param sw_sky130_fd_pr__res_generic_m1_rs = {(0.124+corner_factor*0.019)*(1+process_mc_factor*MC_PR_SWITCH*0.05*sw_sky130_fd_pr__res_generic_m1_rs_mcd)}
.param sw_sky130_fd_pr__res_generic_m2_rs_mcz = 'agauss(0,1,1)'
.param sw_sky130_fd_pr__res_generic_m2_rs_mcd = 'sw_sky130_fd_pr__res_generic_m2_rs_mcz'
.param sw_sky130_fd_pr__res_generic_m2_rs = {(0.124+corner_factor*0.019)*(1+process_mc_factor*MC_PR_SWITCH*0.05*sw_sky130_fd_pr__res_generic_m2_rs_mcd)}
.param sw_sky130_fd_pr__res_generic_m3_rs_mcz = 'agauss(0,1,1)'
.param sw_sky130_fd_pr__res_generic_m3_rs_mcd = 'sw_sky130_fd_pr__res_generic_m3_rs_mcz'
.param sw_sky130_fd_pr__res_generic_m3_rs = {(0.046+corner_factor*0.007)*(1+process_mc_factor*MC_PR_SWITCH*0.05*sw_sky130_fd_pr__res_generic_m3_rs_mcd)}
.param sw_sky130_fd_pr__res_generic_m4_rs_mcz = 'agauss(0,1,1)'
.param sw_sky130_fd_pr__res_generic_m4_rs_mcd = 'sw_sky130_fd_pr__res_generic_m4_rs_mcz'
.param sw_sky130_fd_pr__res_generic_m4_rs = {(0.046+corner_factor*0.007)*(1+process_mc_factor*MC_PR_SWITCH*0.05*sw_sky130_fd_pr__res_generic_m4_rs_mcd)}
.param sw_sky130_fd_pr__res_generic_m5_rs = {0.0275+corner_factor*0.0045}
.param sw_m1_dw = {0.0+corner_factor*-2.5e-08}
.param sw_m2_dw = {0.0+corner_factor*-2.5e-08}
.param sw_m3_dw_mcz = 'agauss(0,1,1)'
